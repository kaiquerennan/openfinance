generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Uma conexao bancaria na Pluggy (resultado do Open Finance / widget).
model Item {
  id              String    @id // id do Item na Pluggy (uuid)
  connectorId     Int
  connectorName   String
  status          String
  executionStatus String?
  pluggyCreatedAt DateTime?
  pluggyUpdatedAt DateTime?
  lastSyncedAt    DateTime  @default(now())

  accounts    Account[]
  investments Investment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

/// Uma conta (corrente, poupanca, cartao) pertencente a um Item.
model Account {
  id            String   @id // id da Account na Pluggy
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type          String? // BANK | CREDIT
  subtype       String?
  name          String?
  marketingName String?
  number        String?
  balance       Decimal? @db.Decimal(18, 2)
  currencyCode  String?

  // Dados de cartao de credito (creditData da Pluggy; nulos em conta corrente).
  // Sem isto nao da pra saber quando a fatura vence nem quanto de limite sobrou
  // — que e justamente o que evita cair no rotativo.
  creditLimit          Decimal?  @db.Decimal(18, 2)
  availableCreditLimit Decimal?  @db.Decimal(18, 2)
  minimumPayment       Decimal?  @db.Decimal(18, 2)
  balanceCloseDate     DateTime? // fechamento da fatura atual
  balanceDueDate       DateTime? // vencimento da fatura atual
  cardBrand            String?
  cardLevel            String?

  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([itemId])
}

/// Uma posicao de investimento (CDB, fundo, acao, etc) pertencente a um Item.
model Investment {
  id           String   @id // id do Investment na Pluggy
  itemId       String
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type         String? // FIXED_INCOME | MUTUAL_FUND | EQUITY | ...
  subtype      String?
  name         String?
  balance      Decimal? @db.Decimal(18, 2)
  amount       Decimal? @db.Decimal(18, 2)
  currencyCode String?
  status       String? // ACTIVE | TOTAL_WITHDRAWAL | ...
  date         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
}

/// Limite de gastos planejado por mes. category = "_global" e o limite geral.
model Budget {
  category  String   @id
  amount    Decimal  @db.Decimal(18, 2)
  updatedAt DateTime @updatedAt
}

/// Meta financeira (objetivo de poupanca) com aportes mensais.
model Goal {
  id                  String      @id @default(cuid())
  name                String
  icon                String      @default("🎯")
  targetAmount        Decimal     @db.Decimal(18, 2)
  initialAmount       Decimal     @default(0) @db.Decimal(18, 2)
  monthlyContribution Decimal?    @db.Decimal(18, 2)
  deadline            DateTime?
  status              String      @default("ACTIVE") // ACTIVE | READY | DONE
  entries             GoalEntry[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

/// Aporte em uma meta, agregado por mes (YYYY-MM).
model GoalEntry {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  month     String
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())

  @@unique([goalId, month])
}

/// Transacao de investimento que ja foi tratada como aporte de meta.
///
/// Metas que dependem de o usuario lembrar de registrar o aporte morrem em
/// poucas semanas. O app detecta as saidas para investimento e sugere
/// contabiliza-las; esta tabela guarda o que ja foi decidido para a mesma
/// transacao nao voltar a ser sugerida.
model GoalSuggestion {
  transactionId String   @id
  /// Meta que recebeu o aporte. Null = o usuario dispensou a sugestao.
  goalId        String?
  createdAt     DateTime @default(now())
}

/// Ultimo envio de cada alerta, para nao repetir a mesma mensagem a cada sync.
model AlertLog {
  key    String   @id
  sentAt DateTime @default(now())
}

/// Uma transacao pertencente a uma Account.
model Transaction {
  id             String   @id // id da Transaction na Pluggy
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date           DateTime
  description    String?
  descriptionRaw String?
  amount         Decimal  @db.Decimal(18, 2)
  balance        Decimal? @db.Decimal(18, 2)
  currencyCode   String?
  type           String? // DEBIT | CREDIT
  category       String?
  categoryId     String?
  providerCode   String?
  status         String?

  // Parcelamento (creditCardMetadata da Pluggy, ou lido da descricao).
  // O extrato mostra so a parcela do mes; sem o total nao da pra saber
  // quanto do mes que vem ja esta comprometido antes de gastar.
  installmentNumber      Int?
  totalInstallments      Int?
  installmentTotalAmount Decimal? @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, date])
}
