# Credenciais da aplicacao Pluggy (dashboard.pluggy.ai)
# NUNCA commitar valores reais — copie este arquivo para .env e preencha
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Base URL da API da Pluggy (normalmente nao precisa mudar)
PLUGGY_BASE_URL=https://api.pluggy.ai

# clientUserId usado ao gerar connect tokens (identifica o usuario no seu sistema)
PLUGGY_CLIENT_USER_ID=me

# Opcional: valor exigido no header X-Webhook-Secret de POST /pluggy/webhook.
# Configure o mesmo valor como header customizado ao registrar o webhook no
# dashboard da Pluggy. Se vazio, o endpoint aceita chamadas sem verificacao.
PLUGGY_WEBHOOK_SECRET=

# Banco de dados (uso futuro com Prisma)
DATABASE_URL=postgresql://user:password@localhost:5434/finance_app?schema=public

# Porta do servidor HTTP
PORT=3000

# Senha de acesso ao app (tela de login) e segredo p/ assinar o cookie de
# sessao. Gere um AUTH_SECRET aleatorio, ex: openssl rand -hex 32
APP_PASSWORD=
AUTH_SECRET=

# Em producao, faz o cookie de sessao exigir HTTPS (Secure)
NODE_ENV=development

# API key gratuita do Google AI Studio (aistudio.google.com/apikey) para o
# assistente de perguntas sobre suas financas (Gemini)
GEMINI_API_KEY=
